  "interview_requests": [
    { "id": "ir-01", "event_id": "ev-03", "journalist_profile_id": "p-05", "subject": "Phỏng vấn Giám đốc Sở VHTTDL về định hướng Festival các năm tiếp theo", "content": "Đề nghị bố trí 20 phút phỏng vấn bên lề Festival, nội dung về định hướng phát triển Festival Huế thành sự kiện thường niên quy mô quốc tế.", "proposed_interviewee_id": "u-admin", "slot_start": "@+1T15:00", "slot_end": "@+1T15:20", "status": "CONFIRMED", "handled_by_id": "u-admin", "note": "Đã xác nhận lịch, phỏng vấn tại phòng VIP Trung tâm báo chí.", "created_at": "@-2T10:00" },
    { "id": "ir-02", "event_id": "ev-03", "journalist_profile_id": "p-02", "subject": "Phỏng vấn nhanh về công tác bảo đảm an toàn cho khách tham dự Festival", "content": "Đề nghị phỏng vấn đại diện ban tổ chức về phương án bảo đảm an ninh, y tế và phòng cháy chữa cháy.", "proposed_interviewee_id": "u-admin2", "slot_start": "@+2T09:00", "slot_end": "@+2T09:15", "status": "ASSIGNED", "handled_by_id": "u-admin", "note": "Đã phân công đồng chí Lê Quang Hiếu trả lời phỏng vấn, chờ xác nhận lịch cụ thể.", "created_at": "@-1T14:30" },
    { "id": "ir-03", "event_id": null, "journalist_profile_id": "p-01", "subject": "Phỏng vấn về kết quả 3 tháng vận hành mô hình chính quyền hai cấp", "content": "Đề nghị phỏng vấn lãnh đạo Sở về những vướng mắc còn tồn tại và giải pháp trong quý tới.", "proposed_interviewee_id": "u-admin", "slot_start": "@+4T14:00", "slot_end": "@+4T14:30", "status": "NEW", "handled_by_id": null, "note": null, "created_at": "@0T09:10" },
    { "id": "ir-04", "event_id": "ev-04", "journalist_profile_id": "p-02", "subject": "Phỏng vấn Người phát ngôn Sở Y tế về chiến dịch phòng chống sốt xuất huyết", "content": "Đề nghị phỏng vấn ngay sau họp báo, thời lượng 15 phút, phục vụ bản tin thời sự tối.", "proposed_interviewee_id": "u-appr-yte", "slot_start": "@+3T16:15", "slot_end": "@+3T16:30", "status": "NEW", "handled_by_id": null, "note": null, "created_at": "@-1T11:00" },
    { "id": "ir-05", "event_id": "ev-02", "journalist_profile_id": "p-13", "subject": "Phỏng vấn chuyên đề về sản phẩm du lịch đêm trong quy hoạch mới", "content": "Đề nghị phỏng vấn chuyên sâu 30 phút phục vụ bài chuyên đề trên Tạp chí.", "proposed_interviewee_id": "u-admin2", "slot_start": "@-13T11:45", "slot_end": "@-13T12:15", "status": "COMPLETED", "handled_by_id": "u-admin", "note": "Đã thực hiện phỏng vấn tại chỗ sau hội nghị.", "created_at": "@-18T15:00" },
    { "id": "ir-06", "event_id": null, "journalist_profile_id": "p-12", "subject": "Phỏng vấn về công tác quản lý di tích ngoài danh mục xếp hạng", "content": "Đề nghị bố trí phỏng vấn lãnh đạo Sở trong tuần này.", "proposed_interviewee_id": "u-admin", "slot_start": "@+2T10:00", "slot_end": "@+2T10:30", "status": "REJECTED", "handled_by_id": "u-admin", "note": "Hồ sơ phóng viên chưa được phê duyệt trên hệ thống. Đề nghị hoàn thiện hồ sơ trước khi gửi yêu cầu phỏng vấn.", "created_at": "@-5T13:00" }
